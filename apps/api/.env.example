# PostgreSQL（异步驱动，用于应用）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mistake_book

# 大模型（OpenAI 或兼容接口，用于 PDF 解析等）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Coze 工作流（优先用于拍照识题）：PAT、工作流 ID、图片参数名
COZE_API_KEY=
COZE_BASE_URL=https://api.coze.cn
COZE_WORKFLOW_ID=
COZE_IMAGE_PARAMETER=image

# 学习报告 Coze 工作流（见 docs/COZE_REPORT_WORKFLOW.md）：输入为 JSON 字符串
COZE_REPORT_WORKFLOW_ID=
COZE_REPORT_WORKFLOW_PARAMETER=input

# 本地存储路径（头像 avatars/、题目图 questions/、PDF pdfs/）
STORAGE_LOCAL_PATH=./uploads

# 生产 HTTPS：设为 true 时，若请求为 http（如 X-Forwarded-Proto=http）则 301 重定向到 https
FORCE_HTTPS=false
# 对外 API 基地址（可选，用于生成绝对 URL）
API_BASE_URL=

# 微信小程序登录
WECHAT_APPID=
WECHAT_SECRET=

# 微信支付（小程序 JSAPI）：商户号、APIv3 密钥、商户私钥路径、证书序列号、支付结果回调 URL
WECHAT_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=

# 积分与广告：每次观看激励视频奖励积分、每用户每日观看上限（防刷）
POINTS_PER_AD_REWARD=10
MAX_AD_REWARDS_PER_DAY=20

# JWT（接口鉴权）
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=720
