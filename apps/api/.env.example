# PostgreSQL（异步驱动，用于应用）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mistake_book

# 大模型（默认：阿里百炼 OpenAI 兼容接口；也可用 OpenAI/DeepSeek 等，改 BASE_URL 与模型名即可）
# API Key：填 OPENAI_API_KEY，或与下面 DASHSCOPE_API_KEY 二选一（后者会合并到前者）
OPENAI_API_KEY=
# 百炼 DashScope API Key（与 OPENAI_API_KEY 二选一）
DASHSCOPE_API_KEY=
OPENAI_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
# 识图（多模态）：百炼 qwen-vl-plus；OpenAI gpt-4o-mini；DeepSeek deepseek-chat
OPENAI_VISION_MODEL=kimi-k2.5
# 纯文本（学习报告、PDF 页解析）：百炼 qwen-plus；OpenAI gpt-4o-mini
OPENAI_CHAT_MODEL=glm-5
# 识图回退时的系统 prompt（可选）；或使用 OPENAI_QUESTION_SYSTEM_PROMPT_FILE 指定文件（内置 K12：prompts/deepseek_question_system.txt）
OPENAI_QUESTION_SYSTEM_PROMPT=
OPENAI_QUESTION_SYSTEM_PROMPT_FILE=prompts/deepseek_question_system.txt
# 识图顺序（OPENAI_* 与 Coze 都配好时）：bailian=百炼/OpenAI 兼容先（默认）；coze=Coze 先
VISION_IMAGE_PRIORITY=bailian

# 识图回退：豆包 Doubao（火山方舟 Ark）
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VISION_MODEL=doubao-seed-1-8-251228

# Coze 工作流（拍照识题回退或 VISION_IMAGE_PRIORITY=coze 时优先）：PAT、工作流 ID、图片参数名、识图请求超时（秒）
COZE_API_KEY=
COZE_BASE_URL=https://api.coze.cn
COZE_WORKFLOW_ID=
COZE_IMAGE_PARAMETER=image
# 识图工作流 HTTP 超时，Coze 处理慢时可调大（如 180、240），默认 120
COZE_WORKFLOW_TIMEOUT=120

# 学习报告 Coze 工作流（见 docs/COZE_REPORT_WORKFLOW.md）：输入为 JSON 字符串
COZE_REPORT_WORKFLOW_ID=
COZE_REPORT_WORKFLOW_PARAMETER=input

# 本地存储路径（头像 avatars/、题目图 questions/、PDF pdfs/）
STORAGE_LOCAL_PATH=./uploads

# 生产 HTTPS：设为 true 时，若请求为 http（如 X-Forwarded-Proto=http）则 301 重定向到 https
FORCE_HTTPS=false
# 对外 API 基地址（可选，用于生成绝对 URL）
API_BASE_URL=

# 微信小程序登录
WECHAT_APPID=
WECHAT_SECRET=

# 微信支付（小程序 JSAPI）：商户号、APIv3 密钥、商户私钥路径、证书序列号、支付结果回调 URL
WECHAT_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY_PATH=
WECHAT_PAY_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=

# 积分与广告：每次观看激励视频奖励积分、每用户每日观看上限（防刷）
POINTS_PER_AD_REWARD=10
MAX_AD_REWARDS_PER_DAY=20

# JWT（接口鉴权）
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=720
